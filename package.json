{
  "name": "previously",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catch up with the stream while it keeps going.",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "setup:local": "node scripts/setup/local.mjs",
    "dev": "tsx watch src/server/index.ts --recover-stale-lock",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-server.mjs",
    "build:public": "vite build --mode public",
    "start": "node dist-server/index.mjs",
    "replay": "tsx src/server/index.ts --replay",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run build:public"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

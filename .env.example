# Copy this file to .env in the project directory. Never commit .env.
# All provider credentials are read by the local server or Vercel server functions.
# None of these secrets may use a VITE_, NEXT_PUBLIC_ or PUBLIC_ prefix.

# LOCAL APP
# TCP port for the local server, streamer dock and OBS overlay.
PORT=4317
# Bind only to the loopback interface. Remote public readers use Vercel.
HOST=127.0.0.1
# Browser origin used for local links, cookie checks and OAuth redirects.
LOCAL_ORIGIN=https://localhost:4317
# Local HTTPS certificate bundle, generated by the setup command and ignored.
LOCAL_TLS_PFX=.data/tls/localhost.pfx
# Passphrase for the local certificate bundle, generated into .env during setup.
LOCAL_TLS_PASSPHRASE=
# Private database, short-lived audio, cached clips and generated narration.
# This directory is ignored by Git. Resolve relative to the project directory.
DATA_DIR=.data
# Random secret with at least 32 bytes for local owner sessions.
# The setup command will generate this locally; do not paste it into chat.
SESSION_SECRET=
# Base64-encoded 32-byte key for encrypting persisted OAuth credentials.
# Keep this key if you want stored authorizations to survive restarts.
TOKEN_ENCRYPTION_KEY=

# TWITCH
# Values from dev.twitch.tv/console/apps. Register category Chat Bot.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Register this exact URL. Remove any extra empty Redirect URL field.
TWITCH_REDIRECT_URI=https://localhost:4317/auth/twitch/callback
# Streamer's Twitch login, without @ or a URL. User IDs are resolved by the app.
TWITCH_CHANNEL_LOGIN=
# Chat replies use the connected broadcaster account. OAuth tokens are obtained
# through Connect Twitch, not pasted here. Live API endpoints are fixed in code;
# the isolated test harness injects Twitch CLI endpoints without live credentials.

# OPENAI
# A funded API key with access to the selected models. Never sent to the browser.
OPENAI_API_KEY=
# Paid provider requests require this explicit switch. Keyless replay never
# dispatches paid requests even when live mode is enabled in this file.
OPENAI_PAID_CALLS_ENABLED=false
# Models and the $4.50 dispatch ceiling are pinned in the provider/storage code.
# The persistent counter survives restarts. An unused env variable cannot change
# either setting. Narration is an opt-in choice in the dock's scene settings.

# PUBLICATION DEFAULTS
# Initial recap output language, independent of recognition: en or ru.
# The owner can change it in the dock. Original transcript language is preserved.
RECAP_LANGUAGE=en
# Delay between the end of a source segment and eligibility for publication.
# Allowed range: 60 to 90 seconds. Moderation and privacy checks must also pass.
PUBLICATION_DELAY_SECONDS=75

# VERCEL PUBLIC RECAP
# HTTPS origin of the user's Vercel deployment, with no trailing slash.
# Leave empty for isolated local replay before deployment.
RECAP_PUBLIC_ORIGIN=
# Random shared secret, at least 32 bytes. Configure the same value locally and
# in Vercel's server environment to authenticate signed publication updates.
PUBLISH_SHARED_SECRET=
# Vercel Blob private-store token, configured in Vercel's server environment.
# It is not needed by the browser. Local publisher uses the signed API instead.
BLOB_READ_WRITE_TOKEN=
